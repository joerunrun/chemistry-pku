# Copy this file to .env on the deployment server, then fill the keys.
# Do not commit the real .env file.

# Image VLM provider: experiment correction, safety check, electrolysis check.
QINIU_API_KEY=
QINIU_MODEL=google/gemini-3.5-flash
QINIU_API_BASE=https://api.qnaigc.com
QINIU_TIMEOUT_SECONDS=180
QINIU_MAX_RETRY=2
QINIU_MAX_IMAGE_SIDE=1280
QINIU_JPEG_QUALITY=75
QINIU_JPEG_OPTIMIZE=false

# Qwen Omni: voice command recognition, audio QA, and TTS.
DASHSCOPE_API_KEY=
OMNI_MODEL=qwen3.5-omni-flash-realtime
OMNI_TTS_MODEL=qwen3.5-omni-plus-realtime
OMNI_VOICE=Ethan
OMNI_TIMEOUT_SECONDS=90
OMNI_TTS_GAIN=1.8

# Runtime assets. In Docker this is overridden to /app/runtime_assets.
CHEM_RUNTIME_ASSETS_DIR=runtime_assets

# Persistent background analysis for uploaded teacher/student audio and photos.
# Audio is transcribed and photos receive a short description; videos are stored only.
CHEM_MEDIA_ANALYSIS_WORKERS=1
MEDIA_ANALYSIS_PROVIDER=qiniu
MEDIA_ANALYSIS_MODEL=google/gemini-3.5-flash

# Optional retrieval tuning.
CHEM_SAFETY_MAX_QUERY_DESCRIPTORS=1000
CHEM_SAFETY_MAX_DB_DESCRIPTORS_PER_SAMPLE=1000
CHEM_ELECTROLYSIS_MAX_QUERY_DESCRIPTORS=100000
CHEM_ELECTROLYSIS_MAX_DB_DESCRIPTORS_PER_SAMPLE=100000
