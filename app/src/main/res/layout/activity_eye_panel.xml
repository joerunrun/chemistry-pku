<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/title_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="化学实验识别"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitle_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="选择功能"
        android:textColor="#D7C4FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/options_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/primary_button"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/glasses_button_background"
            android:focusable="false"
            android:text="实验纠错"
            android:textSize="20sp" />

        <Button
            android:id="@+id/secondary_button"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/glasses_button_background"
            android:focusable="false"
            android:text="安全检查"
            android:textSize="20sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/detection_preview"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="18dp"
        android:adjustViewBounds="true"
        android:background="#151618"
        android:contentDescription="检测框预览"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="18dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/thinking_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="思考中..."
        android:textColor="#D7C4FF"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="前后滑动选择，单击确认"
        android:textColor="#D7C4FF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/result_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="5dp"
        android:minHeight="110dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="18sp" />
</LinearLayout>
