# Reference only; this file is NOT automatically loaded.
# HTTPS placeholders: keep empty until a real hostname/certificate is supplied.
CHEM_PUBLIC_HOST=
CHEM_TLS_CERT_DIR=
# Leave disabled until TLS termination is configured and tested.
CHEM_REQUIRE_HTTPS=0
# Existing APKs do not carry device credentials. Keep disabled until adapted.
CHEM_REQUIRE_DEVICE_AUTH=0
CHEM_ENABLE_DEBUG_ROUTES=0
# CHEM_SESSION_SECRET: use a private random value (32+ characters), never this file.
